# Base URL of the FastAPI backend (public — never put secrets in VITE_ variables).
VITE_API_BASE_URL=http://localhost:8000

# true = use the bundled fictional sample data instead of the backend.
# Never enabled automatically when the backend is unreachable.
VITE_DEMO_MODE=false

# Fallback upload constraints, used only if the backend does not expose GET /config.
# Leave VITE_MAX_UPLOAD_MB empty to apply no client-side size limit.
VITE_ACCEPTED_FILE_TYPES=pdf,docx
VITE_MAX_UPLOAD_MB=
