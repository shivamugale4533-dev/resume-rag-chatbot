# Copy this file to .env and fill in your values:  cp .env.example .env
# NEVER commit the real .env (it contains your API key).

# ---- Gemini (get a free key at https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- CORS: websites allowed to call this API (comma-separated) ----
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Upload limit ----
MAX_UPLOAD_MB=10

# ---- Models (change here if Google renames a model) ----
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---- Retrieval and memory ----
TOP_K=4
MAX_HISTORY_MESSAGES=6

# ---- Storage (relative to the backend folder) ----
CHROMA_DIR=data/chroma
ACTIVE_RESUME_FILE=data/active_resume.json

# ---- RAGAS evaluation (judge models default to the chat/embedding models) ----
# EVAL_LLM_MODEL=gemini-3.8-flash
# EVAL_EMBEDDING_MODEL=gemini-embedding-001
EVAL_DATASET=eval/dataset.json
EVAL_RESULTS_DIR=eval/results
